# Copy to .env and adjust for this host:
#   cp .env.template .env

# Central SigNoz OTel collector (HTTP OTLP — k8s-infra chart)
# Host Docker agent typically uses :4317 (gRPC); this stack uses :4318 (HTTP).
CENTRAL_OTEL_ENDPOINT=http://10.1.1.6:4318

# Kubernetes cluster name attached to telemetry
K8S_CLUSTER_NAME=cvat-mlflow-prod

# deployment.environment resource attribute
ENVIRONMENT=production

# Helm release / namespace for signoz/k8s-infra
HELM_RELEASE=signoz-k8s-infra
HELM_NAMESPACE=platform-monitoring

# Namespaces whose prometheus.io/* annotated pods are scraped
PROMETHEUS_SCRAPE_NAMESPACES=cvat
