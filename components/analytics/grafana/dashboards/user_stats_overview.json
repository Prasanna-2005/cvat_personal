          "pluginVersion": "4.8.2",
          "queryType": "table",
          "rawSql": "SELECT\r\n    user_id AS \"User ID\",\r\n    user_name AS \"Username\",\r\n    project_id AS \"Project ID\",\r\n    task_id AS \"Task ID\",\r\n    -- Total Time Spent (Formatted)\r\n    concat(\r\n        toString(floor(sum(job_total_ms) / 1000 / 3600)), \r\n        'h ',\r\n        toString(floor((sum(job_total_ms) / 1000 % 3600) / 60)), \r\n        'm'\r\n    ) AS \"Total Time Spent\",\r\n    -- Average Time per Job (Formatted)\r\n    concat(\r\n        toString(floor(avg(job_total_ms) / 1000 / 3600)), \r\n        'h ',\r\n        toString(floor((avg(job_total_ms) / 1000 % 3600) / 60)), \r\n        'm'\r\n    ) AS \"Avg Time per Job\",\r\n    -- Number of unique jobs\r\n    count(DISTINCT job_id) AS \"Jobs Worked\",\r\n    -- Average Activity Counts per Job\r\n    round(avg(event_count), 2) AS \"Avg Activity per Job\",\r\n    -- Total Activity (Summed from the subquery)\r\n    sum(event_count) AS \"Total Activity Count\"\r\nFROM (\r\n    -- Subquery: Aggregate time and events at the Job level first\r\n    SELECT\r\n        user_id,\r\n        user_name,\r\n        project_id,\r\n        task_id,\r\n        job_id,\r\n        sum(JSONExtractUInt(payload, 'working_time')) AS job_total_ms,\r\n        count() as event_count\r\n    FROM events\r\n    WHERE JSONHas(payload, 'working_time')\r\n      AND $__timeFilter(timestamp)\r\n      AND (-1 IN (${users}) OR user_id IN (${users}))\r\n      AND (' ' IN (${usernames}) OR user_name IN (${usernames}))\r\n      AND (-1 IN (${projects}) OR project_id IN (${projects}))\r\n      AND (task_id IN (${tasks}))\r\n      AND (job_id IN (${jobs}))\r\n    GROUP BY user_id, user_name, project_id, task_id, job_id\r\n)\r\nGROUP BY user_id, user_name, project_id, task_id\r\nORDER BY sum(job_total_ms) DESC",
          "refId": "A"
        }
      ],
      "title": "User Total Times",
      "type": "table"
    },
