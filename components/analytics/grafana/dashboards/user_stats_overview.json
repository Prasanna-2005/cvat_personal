            }
          },
          "pluginVersion": "4.8.2",
          "queryType": "table",
          "rawSql": "SELECT\r\n    project_id AS \"Project ID\",\r\n    -- Total number of unique tasks in the project\r\n    count(DISTINCT task_id) AS \"Total Tasks\",\r\n    -- Total number of unique jobs in the project\r\n    count(DISTINCT job_id) AS \"Total Jobs\",\r\n    -- Average working time per job across the project\r\n    concat(\r\n        toString(floor(avg(job_total_ms) / 1000 / 3600)), \r\n        'h ',\r\n        toString(floor((avg(job_total_ms) / 1000 % 3600) / 60)), \r\n        'm'\r\n    ) AS \"Avg Time per Job\",\r\n    -- Total cumulative time spent on the project\r\n    concat(\r\n        toString(floor(sum(job_total_ms) / 1000 / 3600)), \r\n        'h ',\r\n        toString(floor((sum(job_total_ms) / 1000 % 3600) / 60)), \r\n        'm'\r\n    ) AS \"Total Time Spent\"\r\nFROM (\r\n    -- Subquery to get total time per job first\r\n    SELECT\r\n        project_id,\r\n        job_id,\r\n        task_id,\r\n        sum(JSONExtractUInt(payload, 'working_time')) AS job_total_ms\r\n    FROM events\r\n    WHERE JSONHas(payload, 'working_time')\r\n      AND $__timeFilter(timestamp)\r\n      AND (-1 IN (${projects}) OR project_id IN (${projects}))\r\n      AND task_id IN (${tasks})\r\n      AND job_id IN (${jobs})\r\n    GROUP BY project_id, task_id, job_id\r\n)\r\nGROUP BY project_id\r\nORDER BY sum(job_total_ms) DESC",
          "refId": "A"
        }
      ],
      "title": "Project Overview",
      "type": "table"
    },
